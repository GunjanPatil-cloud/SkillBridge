# SkillBridge Environment Configuration
# Copy this file to .env for local development. Never commit .env with real credentials.

# Port & Node Environment
PORT=3000
NODE_ENV=development

# Application Base URL
APP_URL="http://localhost:3000"

# Firebase Authentication (Client & Admin)
VITE_FIREBASE_API_KEY="AIzaSyPlaceholderClientApiKey"
VITE_FIREBASE_AUTH_DOMAIN="skillbridge-student.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="skillbridge-student"
VITE_FIREBASE_STORAGE_BUCKET="skillbridge-student.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Firebase Admin SDK (Backend token verification - Check 4)
FIREBASE_PROJECT_ID="skillbridge-student"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@skillbridge-student.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Supabase PostgreSQL Database (Checks 8 & 16)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role_secret"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key"

# Razorpay Payments & Subscriptions (Section 3 & 6, Checks 1 & 3)
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId1234"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecret5678"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecret9012"
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId1234"

# n8n Cloud Automation Integration (Section 8)
N8N_WEBHOOK_URL="https://your-workspace.app.n8n.cloud/webhook/skillbridge-events"
N8N_WEBHOOK_SECRET="n8n_secret_sk_live_safe_token_2026"

# Security & Session Secrets (Checks 1, 3, 17, 19)
JWT_SECRET="super-secret-jwt-signing-key-for-skillbridge-2026"
SESSION_SECRET="skillbridge-session-cryptographic-salt"
ENABLE_STRICT_CSP=true
